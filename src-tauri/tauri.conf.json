{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhistleRocket",
  "version": "../package.json",
  "identifier": "com.whistlerocket.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WhistleRocket",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "WhistleRocket",
    "category": "Productivity",
    "shortDescription": "Al je bedrijven en projecten op één plek",
    "longDescription": "WhistleRocket zet al je bedrijven en projecten op één startscherm, met taken, uren en later mail, agenda, facturen en een ochtend-recap.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Dutch", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
