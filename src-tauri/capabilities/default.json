{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Rechten voor het hoofdvenster van WhistleRocket",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "notification:default",
    "dialog:allow-save",
    "dialog:allow-open",
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "$HOME/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "$HOME/**"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        }
      ]
    }
  ]
}
